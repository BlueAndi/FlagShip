<?xml version="1.0"?>
<robot name="zumo32u4">
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.085 0.065 0.023" />
      </geometry>
      <material name="bright_blue">
        <color rgba="0.0 0.5 1.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.085 0.065 0.023" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.000111" ixy="0.0" ixz="0.0" iyy="0.000164" iyz="0.0" izz="0.000170" />
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.01" />
      </geometry>
      <material name="bright_yellow">
        <color rgba="1.0 1.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="2.03e-06" ixy="0.0" ixz="0.0" iyy="2.03e-06" iyz="0.0" izz="3.24e-06" />
    </inertial>
  </link>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.01" />
      </geometry>
      <material name="bright_yellow">
        <color rgba="1.0 1.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="2.03e-06" ixy="0.0" ixz="0.0" iyy="2.03e-06" iyz="0.0" izz="3.24e-06" />
    </inertial>
  </link>

  <link name="zumo_com_system">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.05 0.01" />
      </geometry>
      <material name="green">
        <color rgba="0.1 0.4 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.05 0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="1.25e-06" ixy="0.0" ixz="0.0" iyy="1.75e-06" iyz="0.0" izz="2.50e-06" />
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 0.0375 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="8.2" velocity="0.525" />
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 -0.0375 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="8.2" velocity="0.525" />
  </joint>

  <joint name="zumo_com_system_joint" type="fixed">
    <parent link="base_link" />
    <child link="zumo_com_system" />
    <origin xyz="-0.005 0 0.018" rpy="0 0 0" />
  </joint>

  <link name="base_laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.01" />
      </geometry>
      <material name="bright_red">
        <color rgba="1.0 0.2 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.01" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="2.08e-06" ixy="0.0" ixz="0.0" iyy="2.08e-06" iyz="0.0" izz="1.56e-06" />
    </inertial>
  </link>

  <link name="base_imu" />

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_imu" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="zumo_com_system" />
    <child link="base_laser" />
    <origin xyz="0 0 0.01" rpy="0 0 0" />
  </joint>

  <webots>
    <device reference="base_laser" type="Lidar">
      <ros>
        <enabled>true</enabled>
        <updateRate>25</updateRate>
        <topicName>/scan</topicName>
        <alwaysOn>true</alwaysOn>
        <frameName>base_laser</frameName>
      </ros>
    </device>
  </webots>

</robot>